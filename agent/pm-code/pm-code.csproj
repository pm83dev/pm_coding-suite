<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pm-code</AssemblyName>
    <RootNamespace>pm_code</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Profilo di publish: eseguibile singolo autocontenuto per Windows x64 -->
  <PropertyGroup Condition="'$(PublishProfile)' == 'win-standalone'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Profilo di publish: eseguibile singolo autocontenuto per Linux x64 (es. Ubuntu) -->
  <PropertyGroup Condition="'$(PublishProfile)' == 'linux-standalone'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\pm-code-core\pm-code-core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Copia il build del frontend nella cartella wwwroot durante il publish -->
  <Target Name="CopyFrontend" AfterTargets="Publish">
    <Message Text="Copia del frontend Angular nella cartella wwwroot..." Importance="High" />
    <!-- Rimuove il contenuto esistente di wwwroot per evitare file obsoleti -->
    <RemoveDir Directories="$(PublishDir)wwwroot" />
    <MakeDir Directories="$(PublishDir)wwwroot" />
    <ItemGroup>
      <FrontendFiles Include="$(MSBuildProjectDirectory)\..\..\ui\web\dist\web\browser\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFolder="$(PublishDir)wwwroot\%(RecursiveDir)" />
  </Target>

  <ItemGroup>
    <!-- Esclude completamente la cartella del test dalla compilazione dell'agente -->
    <Compile Remove="AgentWorkspace\**" />
    <Content Remove="AgentWorkspace\**" />
    <None Remove="AgentWorkspace\**" />
    <Include Remove="AgentWorkspace\**" />
  </ItemGroup>

</Project>
